<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cybernetic-influence.waltzman-public</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/deploy/run-with-provider-secret.sh</string>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>cybernetic_influence.public_waltzman:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8621</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CYBERNETIC_INFLUENCE_BUILD_COMMIT</key>
    <string>__BUILD_COMMIT__</string>
    <key>CYBERNETIC_INFLUENCE_LIVE</key>
    <string>1</string>
    <key>CYBERNETIC_INFLUENCE_PUBLIC_ROOT</key>
    <string>__PUBLIC_ROOT__</string>
    <key>CYBERNETIC_INFLUENCE_OPENROUTER_KEY_FILE</key>
    <string>__OPENROUTER_KEY_FILE__</string>
    <key>CYBERNETIC_INFLUENCE_RUNS_DIR</key>
    <string>__PUBLIC_RUN_ROOT__</string>
    <key>CYBERNETIC_INFLUENCE_CERT_CODEX_LUNA</key>
    <string>__CERT_CODEX_LUNA__</string>
    <key>CYBERNETIC_INFLUENCE_CERT_CODEX_TERRA</key>
    <string>__CERT_CODEX_TERRA__</string>
    <key>CYBERNETIC_INFLUENCE_CERT_COORDINATION_CODEX_LUNA</key>
    <string>__CERT_COORDINATION_CODEX_LUNA__</string>
    <key>CYBERNETIC_INFLUENCE_CERT_COORDINATION_CODEX_TERRA</key>
    <string>__CERT_COORDINATION_CODEX_TERRA__</string>
    <key>LLM_CLIENT_DATA_ROOT</key>
    <string>__LLM_CLIENT_DATA_ROOT__</string>
    <key>LLM_CLIENT_REVISION</key>
    <string>__LLM_CLIENT_REVISION__</string>
    <key>LLM_ROUTE_CERTIFICATION_ROOT</key>
    <string>__LLM_ROUTE_CERTIFICATION_ROOT__</string>
    <key>LLM_CLIENT_OPENROUTER_ROUTING</key>
    <string>off</string>
    <key>LLM_CLIENT_AGENT_BILLING_MODE</key>
    <string>subscription</string>
    <key>LLM_CLIENT_PROJECT</key>
    <string>cybernetic_influence_v3</string>
    <key>LLM_CLIENT_TIMEOUT_POLICY</key>
    <string>allow</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>Umask</key>
  <integer>63</integer>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/cybernetic-influence-waltzman-public.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/cybernetic-influence-waltzman-public.error.log</string>
</dict>
</plist>
