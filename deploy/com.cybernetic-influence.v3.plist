<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cybernetic-influence.v3</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/deploy/run-with-provider-secret.sh</string>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>cybernetic_influence.api:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8620</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CYBERNETIC_INFLUENCE_ALLOWED_TAILSCALE_USERS</key>
    <string>__ALLOWED_TAILSCALE_USERS__</string>
    <key>CYBERNETIC_INFLUENCE_BUILD_COMMIT</key>
    <string>__BUILD_COMMIT__</string>
    <key>CYBERNETIC_INFLUENCE_LIVE</key>
    <string>1</string>
    <key>CYBERNETIC_INFLUENCE_OPENROUTER_KEY_FILE</key>
    <string>__OPENROUTER_KEY_FILE__</string>
    <key>CYBERNETIC_INFLUENCE_RUNS_DIR</key>
    <string>__RUN_ROOT__</string>
    <key>LLM_CLIENT_DATA_ROOT</key>
    <string>__LLM_CLIENT_DATA_ROOT__</string>
    <key>LLM_CLIENT_OPENROUTER_ROUTING</key>
    <string>on</string>
    <key>LLM_CLIENT_PROJECT</key>
    <string>cybernetic_influence_v3</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>Umask</key>
  <integer>63</integer>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOG_ROOT__/cybernetic-influence-v3.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_ROOT__/cybernetic-influence-v3.error.log</string>
</dict>
</plist>
